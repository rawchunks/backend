{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "declaration": true, "outDir": "dist", "rootDir": ".",
    "skipLibCheck": true, "noUncheckedIndexedAccess": true, "types": ["node"]
  },
  "include": ["*.ts", "client/*.ts", "server/*.ts"],
  "exclude": ["dist", "tests"]
}
